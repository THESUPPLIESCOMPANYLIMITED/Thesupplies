# Copy to an untracked local .env only for local development. Never commit real values.
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=8080
AUTOMATION_DB_PATH=./data/receipts.sqlite3

# Generate a distinct high-entropy secret for each webhook source and store it in a
# managed secret store in production. This placeholder is not a usable credential.
WEBHOOK_SECRET_EXAMPLE_SOURCE=replace-with-random-secret-from-secret-manager
